---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { withBase } from '../lib/urls';
import { appName, appStoreUrl, supportEmail } from '../lib/site';

const site = Astro.site ?? new URL('https://getdoubleup.com');
const homeUrl = new URL(withBase(), site).href;

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: appName,
		alternateName: 'Double Up',
		applicationCategory: 'BusinessApplication',
		operatingSystem: 'Shopify',
		url: homeUrl,
		downloadUrl: appStoreUrl,
		image: new URL(withBase('logo.png'), site).href,
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'USD',
		},
		publisher: {
			'@type': 'Organization',
			name: 'Blox Labs, Inc.',
			email: supportEmail,
		},
		description:
			'A Shopify Plus checkout upsell that offers shoppers one more unit of an item already in their cart, at a discount the merchant sets.',
	},
];
---

<BaseLayout
	title="Double Up: Checkout Upsell for Shopify Plus"
	description="Offer one more unit of an item already in the cart, at a discount you set, right in Shopify checkout. One tap to add. Free, with unlimited orders."
	jsonLd={jsonLd}
>
	<Hero />

	<section class="section problem" aria-labelledby="problem-heading">
		<div class="site-wrap">
			<span class="section-label">The simplest upsell there is</span>
			<h2 id="problem-heading" class="section-title">
				No recommendations to tune. They already chose it.
			</h2>
			<p class="section-lead">
				Most upsells guess at what a shopper might want next. Double Up offers more of
				what’s already in the cart: the size, colour and variant they picked, at a price
				that makes a second one easy to say yes to.
			</p>
		</div>
	</section>

	<section class="section how" id="how-it-works" aria-labelledby="how-heading">
		<div class="site-wrap how__grid">
			<div class="how__copy">
				<span class="section-label">How it works</span>
				<h2 id="how-heading" class="section-title">Set a discount. Pick a spot. Done.</h2>
				<p class="section-lead">
					Double Up runs as a checkout extension and a Shopify discount, so the offer
					looks native to your checkout and the price is applied by Shopify itself.
				</p>
				<ol class="how__steps">
					<li>
						<strong>Choose the discount</strong>
						<span>
							Percent off, a fixed amount off, percent off the compare-at price, or cost
							plus a markup. Override it for specific products or collections.
						</span>
					</li>
					<li>
						<strong>Place it in checkout</strong>
						<span>
							Below the header, before the pay button, or under the item in the order
							summary. Edit the heading and button text to match your store.
						</span>
					</li>
					<li>
						<strong>Shoppers add one more</strong>
						<span>
							One tap adds a second unit at the discounted price. Changed their mind?
							Undo removes it again.
						</span>
					</li>
				</ol>
			</div>
			<figure class="how__visual" aria-label="Example Double Up offer in checkout">
				<div class="offer-mock">
					<div class="offer-mock__line">
						<span class="offer-mock__thumb" aria-hidden="true"></span>
						<span class="offer-mock__item">
							<span>Classic Tee</span>
							<small>Black / M</small>
						</span>
						<span class="offer-mock__price">$40.00</span>
					</div>
					<div class="offer-mock__offer">
						<span class="offer-mock__copy">
							<span>Add another Classic Tee</span>
							<span><s>$40.00</s> <strong>$32.00</strong></span>
						</span>
						<span class="offer-mock__btn">Add</span>
					</div>
				</div>
				<figcaption>
					A 20% Double Up offer under the item in the order summary.
				</figcaption>
			</figure>
		</div>
	</section>

	<section class="section features" aria-labelledby="features-heading">
		<div class="site-wrap">
			<span class="section-label">You stay in control</span>
			<h2 id="features-heading" class="section-title">Only the offers you’d make yourself.</h2>
			<ul class="features__grid">
				<li>
					<strong>Protect your margin</strong>
					<span>
						Set a margin floor using each item’s unit cost, and Double Up won’t offer a
						discount that goes below it.
					</span>
				</li>
				<li>
					<strong>Exclude what shouldn’t be doubled</strong>
					<span>
						Leave out products by tag, type, collection, vendor or price range. Tag any
						product <code>no-double-up</code> to skip it.
					</span>
				</li>
				<li>
					<strong>Works with your other discounts</strong>
					<span>
						Choose whether Double Up combines with your order, shipping and product
						discounts.
					</span>
				</li>
				<li>
					<strong>Priced by Shopify, not the browser</strong>
					<span>
						Each offer is signed and checked by a Shopify discount function, so the
						discount applies to exactly one extra unit and can’t be edited in checkout.
					</span>
				</li>
				<li>
					<strong>See what it adds</strong>
					<span>
						The dashboard shows how often the offer is seen, how often it’s accepted,
						and the incremental revenue from the extra units, by day and by product.
					</span>
				</li>
				<li>
					<strong>Only when they say yes</strong>
					<span>
						Nothing changes in the cart until the shopper taps Add. No timers, no
						pre-ticked boxes.
					</span>
				</li>
			</ul>
		</div>
	</section>

	<section class="section pricing" id="pricing" aria-labelledby="pricing-heading">
		<div class="site-wrap pricing__inner">
			<span class="section-label">Pricing</span>
			<h2 id="pricing-heading" class="section-title">Free. Unlimited orders.</h2>
			<div class="pricing__card">
				<p class="pricing__price"><span>Free</span></p>
				<ul>
					<li>Unlimited orders and offers</li>
					<li>Every feature included</li>
					<li>Uninstall at any time</li>
				</ul>
				<a class="btn" href={appStoreUrl} rel="noopener noreferrer">Install free</a>
			</div>
			<p class="pricing__note">
				Requires Shopify Plus, since only Plus stores can add apps to checkout. Development
				and Plus sandbox stores can install it to test.
			</p>
		</div>
	</section>

	<section class="section cta" aria-labelledby="cta-heading">
		<div class="site-wrap cta__inner">
			<h2 id="cta-heading" class="section-title">Make it a double.</h2>
			<p class="section-lead">
				Install Double Up from the Shopify App Store and have your first offer live in
				checkout in minutes.
			</p>
			<a class="btn" href={appStoreUrl} rel="noopener noreferrer">
				Install on Shopify
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.problem {
		border-bottom: 1px solid var(--color-border);
	}

	.how {
		border-bottom: 1px solid var(--color-border);
		background: linear-gradient(180deg, var(--color-bg) 0%, #090909 100%);
	}

	.how__grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.how__steps {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.25rem;
	}

	.how__steps li {
		display: grid;
		gap: 0.35rem;
		padding-left: 1rem;
		border-left: 2px solid var(--color-red);
	}

	.how__steps strong {
		font-family: var(--font-display);
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	.how__steps span {
		color: var(--color-fg-muted);
	}

	.how__visual {
		margin: 0;
		padding: clamp(1.25rem, 4vw, 2.5rem);
		border: 1px solid var(--color-border);
		background:
			radial-gradient(ellipse 80% 60% at 50% 0%, rgba(225, 0, 27, 0.12), transparent 70%),
			#000;
	}

	.how__visual figcaption {
		margin-top: 1rem;
		color: var(--color-fg-muted);
		font-size: 0.9rem;
		text-align: center;
	}

	/* A light, checkout-style card, since that's where shoppers see the offer. */
	.offer-mock {
		display: grid;
		gap: 0.9rem;
		padding: 1.1rem;
		border-radius: 0.6rem;
		background: #fafafa;
		color: #1a1a1a;
		font-size: 0.95rem;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
	}

	.offer-mock__line {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.85rem;
	}

	.offer-mock__thumb {
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 0.45rem;
		border: 1px solid #e3e3e3;
		background: linear-gradient(160deg, #2b2b2b, #111);
	}

	.offer-mock__item {
		display: grid;
		line-height: 1.3;
	}

	.offer-mock__item small {
		color: #707070;
	}

	.offer-mock__offer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.85rem;
		padding: 0.8rem 0.9rem;
		border: 1px solid #dedede;
		border-radius: 0.45rem;
		background: #fff;
	}

	.offer-mock__copy {
		display: grid;
		line-height: 1.35;
	}

	.offer-mock__copy s {
		color: #707070;
	}

	.offer-mock__btn {
		padding: 0.5rem 1.1rem;
		border-radius: 0.4rem;
		background: #1a1a1a;
		color: #fff;
		font-weight: 600;
	}

	.features {
		border-bottom: 1px solid var(--color-border);
	}

	.features__grid {
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 0;
		display: grid;
		gap: 1px;
		border: 1px solid var(--color-border);
		background: var(--color-border);
	}

	.features__grid li {
		display: grid;
		align-content: start;
		gap: 0.45rem;
		padding: 1.5rem;
		background: var(--color-bg);
	}

	.features__grid strong {
		font-family: var(--font-display);
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	.features__grid span {
		color: var(--color-fg-muted);
	}

	.features__grid code {
		color: var(--color-fg);
		font-size: 0.9em;
	}

	.pricing {
		border-bottom: 1px solid var(--color-border);
		text-align: center;
	}

	.pricing__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.pricing__card {
		width: min(100%, 24rem);
		margin-top: 2.25rem;
		padding: 2rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: var(--color-bg-elevated);
	}

	.pricing__price {
		color: var(--color-fg-muted);
		font-family: var(--font-display);
	}

	.pricing__price span {
		color: var(--color-fg);
		font-size: 3rem;
		font-weight: 700;
		letter-spacing: -0.04em;
	}

	.pricing__card ul {
		list-style: none;
		margin: 1.25rem 0 1.75rem;
		padding: 0;
		display: grid;
		gap: 0.5rem;
		color: var(--color-fg-muted);
	}

	.pricing__note {
		margin-top: 1.5rem;
		max-width: 34rem;
		color: var(--color-fg-muted);
		font-size: 0.95rem;
	}

	.cta {
		padding-block: 6rem;
		text-align: center;
		background:
			radial-gradient(ellipse 55% 70% at 50% 100%, rgba(225, 0, 27, 0.16), transparent 65%),
			var(--color-bg);
	}

	.cta__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cta .section-title {
		max-width: 14ch;
	}

	.cta .section-lead {
		margin-bottom: 1.75rem;
		text-align: center;
	}

	@media (min-width: 720px) {
		.features__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 900px) {
		.how__grid {
			grid-template-columns: 1fr 1.05fr;
			gap: 3.5rem;
		}

		.features__grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
