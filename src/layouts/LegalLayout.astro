---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	heading: string;
	effectiveDate: string;
	lastUpdated?: string;
	noindex?: boolean;
}

const { title, description, heading, effectiveDate, lastUpdated, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
	<article class="legal section">
		<div class="site-wrap legal__wrap">
			<span class="section-label">Legal</span>
			<h1>{heading}</h1>
			<p class="legal__meta">
				Effective Date: {effectiveDate}
				{lastUpdated && <> · Last Updated: {lastUpdated}</>}
			</p>
			<div class="legal__body">
				<slot />
			</div>
		</div>
	</article>
</BaseLayout>

<style is:global>
	.legal {
		padding-top: 3.5rem;
		padding-bottom: 5rem;
	}

	.legal__wrap {
		max-width: 46rem;
	}

	.legal h1 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin-bottom: 0.75rem;
	}

	.legal__meta {
		color: var(--color-fg-muted);
		font-size: 0.95rem;
		margin-bottom: 2.5rem;
	}

	.legal__body h2 {
		margin: 2.5rem 0 0.85rem;
		font-size: 1.35rem;
	}

	.legal__body h3 {
		margin: 1.75rem 0 0.65rem;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
	}

	.legal__body p {
		margin: 0.85rem 0;
		color: var(--color-fg-muted);
	}

	.legal__body ul {
		margin: 0.75rem 0 1rem;
		padding-left: 1.25rem;
		color: var(--color-fg-muted);
	}

	.legal__body li {
		margin: 0.4rem 0;
	}

	.legal__body a {
		color: var(--color-fg);
	}

	.legal__body strong {
		color: var(--color-fg);
		font-weight: 600;
	}
</style>
