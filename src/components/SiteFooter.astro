---
import { withBase } from '../lib/urls';
import { appStoreUrl, supportEmail } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-wrap site-footer__inner">
		<a class="footer-brand" href={withBase()} aria-label="Double Up home">
			<img src={withBase('logo-512.png')} alt="" width="28" height="28" />
			<span>Double Up</span>
		</a>
		<p class="footer-copy">© {year}, Blox Labs, Inc.</p>
		<nav class="footer-nav" aria-label="Legal">
			<a href={appStoreUrl} rel="noopener noreferrer">Shopify App Store</a>
			<a href={withBase('faq/')}>FAQ</a>
			<a href={`mailto:${supportEmail}`}>Support</a>
			<a href={withBase('privacy/')}>Privacy Policy</a>
			<a href={withBase('terms/')}>Terms of Use</a>
			<a href={withBase('privacy/#cookies')} data-consent-open>Cookie settings</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding: 2rem 0 2.5rem;
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.footer-brand img {
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 0.4rem;
		border: 1px solid var(--color-border);
	}

	.footer-copy {
		color: var(--color-fg-muted);
		font-size: 0.9rem;
	}

	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.25rem;
	}

	.footer-nav a {
		color: var(--color-fg-muted);
		text-decoration: none;
		font-size: 0.9rem;
	}

	.footer-nav a:hover {
		color: var(--color-fg);
	}
</style>
