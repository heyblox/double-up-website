---
import { withBase } from '../lib/urls';
import { appStoreUrl } from '../lib/site';
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero__plane" aria-hidden="true"></div>
	<div class="site-wrap hero__content">
		<img
			class="hero__logo reveal"
			src={withBase('logo.png')}
			alt="Double Up"
			width="160"
			height="160"
		/>
		<p class="hero__eyebrow reveal reveal-delay-1">Checkout upsell for Shopify Plus</p>
		<h1 id="hero-heading" class="hero__title reveal reveal-delay-1">
			One more of what they’re already buying.
		</h1>
		<p class="hero__lede reveal reveal-delay-2">
			Double Up offers shoppers a second unit of an item in their cart, at a discount you set,
			right in checkout. One tap adds it. No popups, no product picker, no guesswork.
		</p>
		<div class="hero__actions reveal reveal-delay-3">
			<a class="btn" href={appStoreUrl} rel="noopener noreferrer">
				Install on Shopify
			</a>
			<a class="btn btn-ghost" href={`${withBase()}#how-it-works`}>See how it works</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		min-height: calc(100svh - var(--header-height));
		display: grid;
		align-items: center;
		overflow: hidden;
		border-bottom: 1px solid var(--color-border);
	}

	.hero__plane {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(ellipse 70% 55% at 50% 18%, rgba(225, 0, 27, 0.22), transparent 60%),
			radial-gradient(ellipse 50% 40% at 80% 90%, rgba(225, 0, 27, 0.08), transparent 55%),
			linear-gradient(180deg, #000 0%, var(--color-bg) 100%);
	}

	/* Stacked chevrons echo the logo. */
	.hero__plane::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: repeating-linear-gradient(
				135deg,
				transparent 0 46px,
				rgba(255, 255, 255, 0.05) 46px 48px
			),
			repeating-linear-gradient(45deg, transparent 0 46px, rgba(255, 255, 255, 0.05) 46px 48px);
		mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.85), transparent 78%);
	}

	.hero__content {
		padding: 4.5rem 0 5rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero__logo {
		width: clamp(7.5rem, 18vw, 10rem);
		height: auto;
		border-radius: 1.75rem;
		border: 1px solid var(--color-ring);
		margin-bottom: 1.75rem;
	}

	.hero__eyebrow {
		margin-bottom: 0.85rem;
		color: var(--color-red);
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.hero__title {
		max-width: 16ch;
		font-size: clamp(2.4rem, 7vw, 4.4rem);
	}

	.hero__lede {
		margin-top: 1.25rem;
		max-width: 36rem;
		color: var(--color-fg-muted);
		font-size: clamp(1.05rem, 2vw, 1.2rem);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
